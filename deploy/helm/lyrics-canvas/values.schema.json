{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "lyrics-canvas values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "serviceType": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?$" },
    "accessModes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
    },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      }
    },
    "envVar": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "promDuration": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
    },
    "promRange": { "type": "string", "pattern": "^[1-9][0-9]*(s|m|h|d|w)$" },
    "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "for": { "$ref": "#/definitions/promDuration" },
        "severity": { "$ref": "#/definitions/severity" }
      }
    },
    "scheduling": {
      "podAnnotations": { "$ref": "#/definitions/stringMap" },
      "podLabels": { "$ref": "#/definitions/stringMap" },
      "podSecurityContext": { "type": "object" },
      "securityContext": { "type": "object" },
      "nodeSelector": { "$ref": "#/definitions/stringMap" },
      "tolerations": { "type": "array", "items": { "type": "object" } },
      "affinity": { "type": "object" }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
        }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "type": { "$ref": "#/definitions/serviceType" }, "port": { "$ref": "#/definitions/port" } }
        },
        "secretKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "corsOrigins": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
        "googleClientId": { "type": "string" },
        "accessTokenExpireMinutes": { "type": "integer", "minimum": 1 },
        "extraEnv": { "type": "array", "items": { "$ref": "#/definitions/envVar" } },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "attempts": { "type": "integer", "minimum": 1 },
            "delaySeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "startupTimeoutSeconds": { "type": "integer", "minimum": 5 },
        "relatedWords": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warmup": { "type": "boolean" },
            "cacheDir": { "type": "string" }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vocabHints": { "type": "boolean" },
            "vocabHintMaxChars": { "type": "integer", "minimum": 0 },
            "exportMaxBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "modelCache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "$ref": "#/definitions/quantity" },
                "storageClass": { "type": "string" },
                "accessModes": { "$ref": "#/definitions/accessModes" },
                "existingClaim": { "type": "string" }
              }
            }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/definitions/serviceType" },
            "port": { "$ref": "#/definitions/port" },
            "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
          }
        },
        "containerPort": { "$ref": "#/definitions/port" },
        "clusterAlerts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alertmanagerUrl": {
              "type": "string",
              "pattern": "^(https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?/?)?$"
            },
            "namespace": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$" },
            "resolver": {
              "type": "string",
              "pattern": "^((([0-9]{1,3}\\.){3}[0-9]{1,3}|\\[[0-9A-Fa-f:.]+\\])(:[0-9]{1,5})?( (([0-9]{1,3}\\.){3}[0-9]{1,3}|\\[[0-9A-Fa-f:.]+\\])(:[0-9]{1,5})?)*)?$"
            }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "stt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "port": { "$ref": "#/definitions/port" } }
        },
        "model": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
        "device": { "type": "string", "enum": ["cuda", "cpu"] },
        "computeType": {
          "type": "string",
          "enum": ["", "default", "auto", "int8", "int8_float32", "int8_float16", "int8_bfloat16", "int16", "float16", "bfloat16", "float32"]
        },
        "gpus": { "type": "integer", "minimum": 0 },
        "gpuResourceName": { "type": "string", "pattern": "^[A-Za-z0-9.-]+/[A-Za-z0-9._-]+$" },
        "runtimeClassName": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$" },
        "defaultLanguage": { "type": "string", "pattern": "^([a-z]{2,3})?$" },
        "beamSize": { "type": "integer", "minimum": 1 },
        "maxUploadBytes": { "type": "integer", "minimum": 1 },
        "offline": { "type": "boolean" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warning", "error"] },
        "modelCache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["emptyDir", "hostPath", "persistentVolumeClaim"] },
            "hostPath": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "path": { "type": "string", "pattern": "^(/.*)?$" } }
            },
            "persistentVolumeClaim": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingClaim": { "type": "string" },
                "size": { "$ref": "#/definitions/quantity" },
                "storageClass": { "type": "string" },
                "accessModes": { "$ref": "#/definitions/accessModes" }
              }
            }
          }
        },
        "startupTimeoutSeconds": { "type": "integer", "minimum": 5 },
        "extraEnv": { "type": "array", "items": { "$ref": "#/definitions/envVar" } },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      },
      "if": {
        "required": ["enabled", "modelCache"],
        "properties": {
          "enabled": { "const": true },
          "modelCache": { "properties": { "type": { "const": "hostPath" } } }
        }
      },
      "then": {
        "properties": {
          "modelCache": {
            "required": ["hostPath"],
            "properties": { "hostPath": { "required": ["path"], "properties": { "path": { "minLength": 1 } } } }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "database": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "port": { "$ref": "#/definitions/port" } }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "$ref": "#/definitions/quantity" },
            "storageClass": { "type": "string" },
            "accessModes": { "$ref": "#/definitions/accessModes" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "pattern": "^(@(yearly|annually|monthly|weekly|daily|midnight|hourly)|\\S+( +\\S+){4})$" },
        "timeZone": { "type": "string" },
        "retain": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["hostPath", "persistentVolumeClaim"] },
            "hostPath": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "path": { "type": "string", "pattern": "^(/.*)?$" } }
            },
            "persistentVolumeClaim": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingClaim": { "type": "string" },
                "size": { "$ref": "#/definitions/quantity" },
                "storageClass": { "type": "string" },
                "accessModes": { "$ref": "#/definitions/accessModes" }
              }
            }
          }
        },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 10 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      },
      "if": {
        "required": ["enabled", "destination"],
        "properties": {
          "enabled": { "const": true },
          "destination": { "properties": { "type": { "const": "hostPath" } } }
        }
      },
      "then": {
        "properties": {
          "destination": {
            "required": ["hostPath"],
            "properties": { "hostPath": { "required": ["path"], "properties": { "path": { "minLength": 1 } } } }
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName"],
            "properties": {
              "secretName": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "routeApiToBackend": { "type": "boolean" }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "$ref": "#/definitions/stringMap" },
            "kubectlCommand": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+( [A-Za-z0-9_./-]+)*$" },
            "podNotReady": { "$ref": "#/definitions/alert" },
            "containerRestarts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "threshold": { "type": "integer", "minimum": 1 },
                "window": { "$ref": "#/definitions/promRange" },
                "for": { "$ref": "#/definitions/promDuration" },
                "severity": { "$ref": "#/definitions/severity" }
              }
            },
            "containerWaiting": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "for": { "$ref": "#/definitions/promDuration" },
                "severity": { "$ref": "#/definitions/severity" },
                "reasons": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[A-Za-z]+$" }
                }
              }
            },
            "workloadUnavailable": { "$ref": "#/definitions/alert" },
            "metricsAbsent": { "$ref": "#/definitions/alert" },
            "backup": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "maxAgeHours": { "type": "integer", "minimum": 1 },
                "staleFor": { "$ref": "#/definitions/promDuration" },
                "failedFor": { "$ref": "#/definitions/promDuration" },
                "severity": { "$ref": "#/definitions/severity" }
              }
            }
          }
        }
      }
    }
  }
}

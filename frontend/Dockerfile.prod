# Production image: Vite build served by nginx, with /api proxied to the backend
# and /_status/alerts proxied to the cluster's Alertmanager.
#
#   docker build -f Dockerfile.prod -t lyrics-canvas-frontend \
#     --build-arg VITE_GOOGLE_CLIENT_ID=<client id> .
#
# VITE_* values are baked in at build time. VITE_API_URL stays empty so the SPA
# calls /api relative to its own origin; nginx forwards that to $BACKEND_URL.

FROM node:20-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=""
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_API_URL=$VITE_API_URL \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build


FROM nginxinc/nginx-unprivileged:1.27-alpine

# Rendered to /etc/nginx/conf.d/default.conf by the image entrypoint (envsubst).
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
# Sourced by the entrypoint before the template is rendered; validates the
# cluster alerts settings and exports the values the template uses.
COPY --chmod=0755 nginx/entrypoint/16-cluster-alerts.envsh /docker-entrypoint.d/16-cluster-alerts.envsh
COPY --from=build /app/dist /usr/share/nginx/html

ENV BACKEND_URL=http://backend:8000
# GET /_status/alerts (docs/features/cluster_alerts_endpoint.md). Empty
# ALERTMANAGER_URL makes it answer []; ALERTS_RESOLVER empty means the
# nameservers from /etc/resolv.conf.
ENV ALERTMANAGER_URL="" \
    ALERTS_NAMESPACE="" \
    ALERTS_RESOLVER=""

EXPOSE 8080

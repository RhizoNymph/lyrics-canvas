# Production image: Vite build served by nginx, with /api proxied to the backend.
#
#   docker build -f Dockerfile.prod -t lyrics-canvas-frontend \
#     --build-arg VITE_GOOGLE_CLIENT_ID=<client id> .
#
# VITE_* values are baked in at build time. VITE_API_URL stays empty so the SPA
# calls /api relative to its own origin; nginx forwards that to $BACKEND_URL.

FROM node:20-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=""
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_API_URL=$VITE_API_URL \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build


FROM nginxinc/nginx-unprivileged:1.27-alpine

# Rendered to /etc/nginx/conf.d/default.conf by the image entrypoint (envsubst).
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

ENV BACKEND_URL=http://backend:8000

EXPOSE 8080
